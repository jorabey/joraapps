{
  "version": 2,
  "name": "joraapps",
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/old-page", "dest": "/new-page", "status": 301 },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/((?!api/).*)", "dest": "/index.html", "status": 200 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
  "source": "/index.html",
  "headers": [
    {
      "key": "Cache-Control",
      "value": "public, max-age=0, must-revalidate"
    }
  ]
}
  ],
  "redirects": [
    { "source": "/admin", "destination": "https://admin-joraapps.vercel.app", "permanent": false }
  ],
  "rewrites": [
   {
      "source": "/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://api-joraapps.vercel.app/sitemap.xml" 
    }
  ],
  "regions": ["fra1"],
  "buildCommand": "npm run build",
"outputDirectory": "dist",
"devCommand": "npm run dev",
"installCommand": "npm install",
"ignoreCommand": "git diff --quiet HEAD^ HEAD ./src",
"github": {
  "silent": true,
  "autoJobCancelation": true
},
"unsupportedPlatforms": {
  "browser": ["ie"]
},
  "cleanUrls": true,
  "trailingSlash": false
}