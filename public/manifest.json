{
  "short_name": "JoraApps",
  "name": "Jora Apps",
  "description": "The ultimate mini-app platform.",
  "id": "/?utm_source=pwa",
  "scope": "/",
  "start_url": "/apps",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "display": "standalone",
  "dir": "ltr",
  "lang": "en-EN",
  "orientation": "portrait",
  "theme_color": "#0a0c10",
  "background_color": "#0a0c10",
  "categories": ["utilities", "games", "entertainment", "productivity", "lifestyle"],
  "prefer_related_applications": false,
  "virtual_keyboard": "modes-overlay",
  "handle_links": "preferred",
  "launch_handler": {
  "client_mode": ["navigate-existing", "focus-existing"]
},
  "note_taking": {
  "note_new_url": "/new-note"
},
  "edge_side_panel": {
  "src": "/sidebar-app"
},
  "related_applications": [
  {
    "platform": "play",
    "id": "com.jora.apps",
    "url": "https://play.google.com/store/apps/details?id=com.jora.apps"
  }
],
  "file_handlers": [
  {
    "action": "/open-file",
    "accept": {
      "application/jora": [".joraapps"]
    }
  }
],
  "protocol_handlers": [
  {
    "protocol": "joraapps",
    "url": "/apps/handler?link=%s"
  }
],
  "share_target": {
  "action": "/share",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
    "title": "name",
    "text": "description",
    "url": "link",
    "files": [
      {
        "name": "media",
        "accept": ["image/*", "video/*", "application/pdf"]
      }
    ]
  }
},
  "icons": [
    {
      "src": "icons/icon-192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "icons/icon-512.png",
      "type": "image/png",
      "sizes": "512x512"
    },
    {
      "src": "icons/icon-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Apps",
      "short_name": "Store",
      "description": "View application list",
      "url": "/apps",
      "icons": [{ "src": "icons/apps-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My apps",
      "short_name": "My applications",
      "description": "List of connected applications",
      "url": "/app-connections",
      "icons": [{ "src": "icons/my-apps-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Personal profile",
      "short_name": "Profile",
      "description": "Account settings",
      "url": "/profile",
      "icons": [{ "src": "icons/profile-icon-192.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile-1.png",
      "sizes": "663x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Profile"
    },
    {
      "src": "/screenshots/mobile-2.png",
      "sizes": "412x800",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "App About"
    },
    {
      "src": "/screenshots/desktop-1.png",
      "sizes": "1442x902",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Profile"
    },
    {
      "src": "/screenshots/desktop-2.png",
      "sizes": "1442x902",
      "type": "image/png",
      "form_factor": "wide",
      "label": "App About"
    }
  ]
}
